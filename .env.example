# ═══════════════════════════════════════════════════════
# Supreme Tailors — Environment Variables
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════

# ── Supabase (get from: Supabase Dashboard → Settings → API) ──
# Project URL — public, safe for browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon Key — public, safe for browser (used by client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — SECRET! Server-only. Bypasses RLS.
# ⚠️ Never expose this in client code or commit to git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Fast2SMS (get from: fast2sms.com → Dev API) ──
# Used to send SMS notifications when orders are ready
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Admin Reference ──
# Must match the email used when creating the admin user in Supabase Auth
NEXT_PUBLIC_ADMIN_EMAIL=admin@supremetailors.com
